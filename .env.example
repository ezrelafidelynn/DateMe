# --- backend/.env ---
MONGODB_URI=mongodb://127.0.0.1:27017/ezmatch
PORT=5001
JWT_SECRET=change-me-to-a-long-random-string
NODE_ENV=development

# Client origin(s) allowed by CORS + Socket.io (comma-separated)
CLIENT_URL=http://localhost:5173

# Optional — image hosting. Leave blank to store data URLs inline (fine for local dev).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional — sketch moderation provider. "heuristic" (default) runs local checks only.
MODERATION_PROVIDER=heuristic
